// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.245.0/containers/docker-existing-dockerfile
{
	"name": "Existing Dockerfile",

	"build": {
		"dockerfile": "../Dockerfile",
		"args": {
			"VERSION": "00001122334455_0123abc",
			"DEV": "true"
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Uncomment the next line to run commands after the container is created - for example installing curl.
	// "postCreateCommand": "apt-get update && apt-get install -y curl",
	"postCreateCommand": "bash -lc 'if [ -d /workspace/embeddings-classifier ]; then uv pip install -e /workspace/embeddings-classifier; else echo \"Optional mount /workspace/embeddings-classifier not found; using pinned release install\"; fi'",

	// Uncomment when using a ptrace-based debugger like C++, Go, and Rust
	"runArgs": ["--memory=16g", "--memory-swap=18g"],

	"containerEnv": {},

	// "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
    // "workspaceFolder": "/app",

	// Uncomment to use the Docker CLI from inside the container. See https://aka.ms/vscode-remote/samples/docker-from-docker.
	"mounts": [
        "source=${localWorkspaceFolder}/tests/files/,target=/mnt/test_files,type=bind",
		"source=${localWorkspaceFolder}/tests/mounted/output,target=/mnt/output,type=bind",
		"source=${localWorkspaceFolder}/../embeddings-classifier,target=/workspace/embeddings-classifier,type=bind"
	],

	// Uncomment to connect as a non-root user if you've added one. See https://aka.ms/vscode-remote/containers/non-root.
	// "remoteUser": "appuser",

	// Configure tool-specific properties.
	"customizations": {
		// Configure properties specific to VS Code.
		"vscode": {
			"settings": {
				"python.testing.pytestArgs": [
					"tests/unit_tests",
					"tests/integration_tests",
					"tests/end_to_end_tests"
				]
			},
			"extensions": [
				"ms-python.python",
				"ms-python.pylint"
			]
		}
	}

}